# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# electron-builder output
dist/
release/
# 打包产物的压缩包（体积远超 GitHub 单文件上限，不入库）
release.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 冒烟/校验脚本留下的诊断日志（失败时 dump，含机器相关路径，不入库）
logs/

# env files (can opt-in for committing if needed)
.env*
# 但模板要入库：别人靠它知道有哪些键
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated images (dev default output sibling folder)
* Output/

# python agent（apps/agent）——依赖与缓存不入库，与 .venv 一起随包分发或打成单文件
apps/agent/.venv/
apps/agent/build/
apps/agent/dist/
__pycache__/
*.pyc
# pip install -e . 的元数据副产物（运行时不需要，见 apps/agent/README.md）
*.egg-info/
