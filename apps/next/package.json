{
  "name": "@illusion-realm/next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/sync-changelog.mjs && next dev --webpack",
    "build": "node ../../scripts/sync-changelog.mjs && next build && node ../../scripts/record-build-fingerprint.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:en": "node scripts/check-i18n-en.mjs",
    "check:i18n:en:list": "node scripts/check-i18n-en.mjs --list",
    "mirror-locale": "node scripts/mirror-locale.mjs",
    "check:i18n:list": "node scripts/check-i18n.mjs --list",
    "check:meta": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-image-meta.mjs",
    "check:gates": "node scripts/self-test-gates.mjs",
    "survey:meta": "node scripts/survey-image-meta.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@illusion-realm/shared": "workspace:*",
    "clsx": "^2.1.1",
    "exifreader": "^4.41.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pako": "^3.0.1",
    "png-chunk-text": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-sketch-canvas": "8.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
