# Illusion Realm 工作区共用配置与独立云后端配置模板
#
# 用法：复制成 `.env` 再填自己的值（`.env` 不入库；dev 读工作区根，打包读 exe 同目录）。
#     Copy-Item .env.example .env
#
# 约定：这里只放跨模块共用或独立云后端部署所需的键；单模块专属的开关写进各自代码的注释与文档，
# 不要往这个文件里堆。真·环境变量优先级最高（会覆盖本文件），方便临时覆盖 / CI。

# ---- Agent（apps/agent，Python sidecar）----

# 密钥。**只有主进程读它**，再经 stdin 传给 sidecar；
# 永不进渲染进程、不进日志、不进命令行参数。
ILLUSION_AGENT_API_KEY=sk-your-key-here

# 模型与网关（换成 DeepSeek 官方 / 阿里百炼 / OpenAI 都只改这两行 + 密钥）
ILLUSION_AGENT_BASE_URL=https://api.siliconflow.cn/v1
ILLUSION_AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 工具循环上限（防模型和工具来回几十次）
AGENT_MAX_STEPS=8

# 权限档位：readonly（默认，不挂写盘类工具）| full
ILLUSION_AGENT_PERMISSION=readonly

# 只读工具允许访问的目录白名单（多个用 ; 分隔，Windows）；留空 = 不允许访问文件系统
# ILLUSION_AGENT_ALLOWED_ROOTS=D:\Code\Web_project\Priveate-blog-main\Illusion Realm Output

# 单次运行上限（毫秒，默认 5 分钟）
# ILLUSION_AGENT_TIMEOUT_MS=300000

# 指定解释器 / 打包产物（一般不用填：会自动找 apps/agent/.venv，再退到系统 python）
# ILLUSION_AGENT_PYTHON=D:\path\to\python.exe

# ---- 独立云后端：TiDB MySQL 兼容数据库 + Upstash Redis TLS ----
# 仅服务端读取，不能改为 NEXT_PUBLIC_ 或打包进桌面安装包。
# URL 中的密码必须经过 URL 编码；本模板不放实际用户名、地址或密钥。
DATABASE_URL="mysql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_HOST:4000/illusion-Realm"
# 后端配置加载器将下列布尔值映射为 MySQL 驱动的 TLS 选项。
MYSQL_SSL_ENABLED=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# 当前使用 TCP + TLS；后端根据传输类型选择连接，不能将 REST URL 传给 Lettuce。
REDIS_TRANSPORT=tcp
REDIS_URL="rediss://default:YOUR_URL_ENCODED_REDIS_PASSWORD@YOUR_DATABASE.upstash.io:6379"
# 仅切换为 rest 时需要以下 Token；不要假定 TCP 密码与 REST Token 可以互换。
UPSTASH_REDIS_REST_URL="https://YOUR_DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
REDIS_KEY_PREFIX="ir:dev:v1:"
